# Hedera — Attention Trust Oracle
ORACLE_HEDERA_ACCOUNT_ID=
ORACLE_HEDERA_PRIVATE_KEY=
ORACLE_UAID=

# Hedera — Agent (consumer, signs & submits all transactions)
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
AGENT_UAID=

# x402 facilitator
FACILITATOR_URL=https://api.testnet.blocky402.com
# Price the Oracle charges per /verify-attention call, in tinybar (1 HBAR = 1e8 tinybar)
ORACLE_PRICE_PER_CALL_TINYBAR=50000

# HCS
HCS_TOPIC_IDENTITY_REGISTRY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Redis (BullMQ + diversity aggregate)
REDIS_URL=redis://localhost:6379

# Selfie Check (World ID / IDKit) — get these from https://developer.world.org.
# SIGNER_KEY must stay backend-only: it signs every RP request server-side,
# for both the reader-side escalation (routes/world.ts) and creator login.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_SIGNER_KEY=

# App
PORT=3000
NODE_ENV=development
HEDERA_NETWORK=testnet
# Public URL this server is reachable at — used as the Oracle's endpoint (identity
# profile) and as the base for the Agent's own calls back to /verify-attention.
BASE_URL=http://localhost:3000